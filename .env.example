# Copy to .env and `set -a; source .env; set +a` before running scripts.

# ---- shared, keep identical on both sides ----
# From https://console.anthropic.com -> Settings -> API Keys. Side B also needs it as an
# Agent Engine secret: agentengine secret set ANTHROPIC_API_KEY --project-scope
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_CONTEXT_TOKENS=1500
VERIFY_BEFORE_OFFER=false

# ---- Side A · AgentCore ----
AWS_REGION=ap-southeast-1
SIDE_A_RUNTIME_ARN=arn:aws:bedrock-agentcore:ap-southeast-1:123456789012:runtime/CardAgent-xxxx
AGENTCORE_MEMORY_ID=
# Aurora with IAM database auth (e.g. express configuration): a fresh token is generated per connection.
BANK_PG_IAM_AUTH=true
BANK_PG_HOST=your-cluster.cluster-xxxx.ap-southeast-1.rds.amazonaws.com
BANK_PG_PORT=5432
BANK_PG_DBNAME=harbourline
BANK_PG_USER=postgres
# Or, with a password instead: set BANK_PG_IAM_AUTH=false and quote the whole DSN.
# BANK_PG_DSN="host=your-aurora-endpoint port=5432 dbname=harbourline user=bakeoff password=change-me sslmode=require"

# ---- Side B · Atlas Agent Engine ----
MONGODB_URI=mongodb+srv://user:pass@your-cluster.mongodb.net
BANK_DB=harbourline
AE_PROJECT_ID=
AE_WORKSPACE_ID=
AE_CLIENT_ID=
AE_CLIENT_SECRET=
# Fill these after `python side_b_atlas/scripts/audit_join.py --inspect`
MEMORY_SEMANTIC_COLL=semantic
MEMORY_USER_FIELD=user_id
MEMORY_TEXT_FIELD=text
